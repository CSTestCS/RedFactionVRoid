#include <windows.h>
#include "resource.h"

IDR_PAYLOAD_DLL RCDATA "@PAYLOAD_DLL@"

1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @RFV_VERSION_COMMAS@
PRODUCTVERSION @RFV_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "RedFactionVRoid installer"
      VALUE "ProductName", "RedFactionVRoid"
      VALUE "FileVersion", "@RFV_VERSION@"
      VALUE "ProductVersion", "@RFV_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
